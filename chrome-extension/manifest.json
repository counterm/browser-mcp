{
  "manifest_version": 3,
  "name": "Page Bridge",
  "version": "0.1.0",
  "description": "把浏览器页面广播给本地 broker (127.0.0.1:8766)，供任意 CLI/IDE 发现并接入控制",
  "minimum_chrome_version": "116",
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "http://127.0.0.1:8766/*",
        "http://localhost:8766/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
